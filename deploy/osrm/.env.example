# Copy to `.env` and adjust. `build-graph.sh` and `docker-compose.yml` both read it.

# Region extract the foot-profile graph is built from.
# Default: Ontario (covers Toronto). Swap for any Geofabrik .osm.pbf as needed.
OSRM_EXTRACT_URL=https://download.geofabrik.de/north-america/canada/ontario-latest.osm.pbf

# Dataset basename OSRM derives from the .pbf (the filename without `.osm.pbf`).
# MUST match the extract above — it names the processed graph files.
OSRM_DATASET=ontario-latest

# Host address osrm-routed binds to. Keep it on localhost and terminate TLS in
# front (see Caddyfile.example) — OSRM has no auth of its own.
OSRM_BIND=127.0.0.1:5000

# OSRM backend image. `:latest` matches the runbook's verified image; pin to a
# release tag (e.g. `:v6.0.0`) for reproducible rebuilds.
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:latest

# Where the .pbf and processed graph live on the host (relative to this dir by
# default, so everything stays self-contained).
OSRM_DATA_DIR=./data
